# Copy to .env and fill in. POSTGRES_PASSWORD and DATABASE_URL have no defaults
# on purpose: compose refuses to start rather than fall back to a known password.

# Frontend
FRONTEND_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
BACKEND_PORT=8000

# Every origin the browser app is served from. No wildcard: the API sends
# credentials, and "*" would expose personal data to any website.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. The container publishes no host port; reach it via
# `docker compose exec db psql -U remscheid_ops remscheid_ops`.
POSTGRES_DB=remscheid_ops
POSTGRES_USER=remscheid_ops
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://remscheid_ops:<same-password>@db:5432/remscheid_ops

# Storage
UPLOADS_DIR=/app/uploads

# App. APP_ENV=production refuses to start while AUTH_MODE=dev.
APP_ENV=development
APP_BRANCH_DEFAULT=Remscheid
APP_TIMEZONE=Europe/Berlin

# --- Authentication -------------------------------------------------------
# dev      = caller sends X-User-Id, only for local work and testing
# azure_ad = Microsoft Entra ID bearer tokens are validated on every request
AUTH_MODE=dev
# Optional: identity used when no X-User-Id header is sent (dev mode only).
AUTH_DEV_DEFAULT_USER_ID=

# --- Microsoft Entra ID (Azure AD) ----------------------------------------
# Prepared, not active. Setup: docs/azure-ad-setup.md
# Switching AUTH_MODE to azure_ad requires AZURE_TENANT_ID and AZURE_CLIENT_ID.
AZURE_TENANT_ID=
# Application (client) id of the API app registration.
AZURE_CLIENT_ID=
# Defaults to api://<AZURE_CLIENT_ID> when empty.
AZURE_API_AUDIENCE=
# Maps Entra app roles or group object ids onto the local roles.
# Example: OpsManager=Niederlassungsleiter,OpsHSE=HSE / Compliance,OpsViewer=Betrachter
AZURE_ROLE_MAP=
AZURE_AUTO_PROVISION_USERS=true
# Role for provisioned users without a mapped app role. Empty = no permissions.
AZURE_DEFAULT_ROLE_NAME=
# Frontend (SPA) app registration and the scope it requests.
AZURE_FRONTEND_CLIENT_ID=
AZURE_API_SCOPE=

# Optional Hermes agent communication. Keep secrets server-side.
HERMES_API_BASE_URL=http://host.docker.internal:8642/v1
HERMES_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
