# Frontend
FRONTEND_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=remscheid_ops
POSTGRES_USER=remscheid_ops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://remscheid_ops:change-me@db:5432/remscheid_ops

# Storage
UPLOADS_DIR=/app/uploads

# App
APP_ENV=development
APP_BRANCH_DEFAULT=Remscheid
APP_TIMEZONE=Europe/Berlin

# Optional Hermes agent communication. Keep secrets server-side.
HERMES_API_BASE_URL=http://host.docker.internal:8642/v1
HERMES_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
